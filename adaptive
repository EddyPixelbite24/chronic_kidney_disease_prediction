def adaptive_permutation_importance(model, X, y, initial_importance, metric='accuracy', n_repeats=50, aggression=0.35, seed=42):
np.random.seed(seed)
baseline_score = metric(y, model.predict(X))
imp_all = []
for i in range(n_repeats):
        imp_round = np.zeros(X.shape[1])
        for i in range(X.shape[1]):
            X_permuted = X.copy()
            # Adaptive: Permute fewer samples for important features
            importance_weight = 1 - (initial_importance[i] / max(initial_importance))
            n_samples = int(X.shape[0] * (aggression * importance_weight))
            if n_samples > 0:
                idx = np.random.choice(X.shape[0], n_samples, replace=False)
                X_permuted[idx, i] = np.random.permutation(X_permuted[idx, i])
            imp_round[i] = baseline_score - metric(y, model.predict(X_permuted))
        imp_all.append(imp_round)
imp_all = np.array(imp_all)
return np.mean(imp_all, axis=0), np.std(imp_all, axis=0)

def find_optimal_aggression(model, X, y, inital_importance, aggression range=np.arrange(0.05, 1.01, 0.05), n_repeats=50, seed=42):
results={}
for aggression in aggression range:
std = adaptive_permutation_importance(model, X, y, initial_importance, n_repeats=n_repeats, aggression=aggression, seed=seed)
results[aggression] = np.mean(std)
best_aggression = min(results, key=results.get)

best_agg = find_optimal_aggression(model, X_test, y_test, importance_vals)
imp_vals_adaptive, std_adaptive = adaptive_permutation_importance(
    model, X_test, y_test, metric='accuracy', n_repeats=50, aggression=best_agg)

indices = np.argsort(imp_values_adaptive)[::1]
plt.figure()
plt.title("Adaptive Permutation Importance")
plt.bar(range(X_train.shape[1]), imp_vals_adaptive[indices], yerr=std_adaptive[indices])

plt.xticks(range(X_train.shape[1]), df_subset.drop('class', axis=1).columns[indices], rotation=90) 
plt.xlim([-1, X_train.shape[1]])
plt.ylim([0, max(imp_vals)*1.1])

